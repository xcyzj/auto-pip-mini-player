#!/bin/sh
# git pre-commit 钩子：提交前扫描"即将提交的内容"（已暂存的改动）。
# 发现密钥/令牌就中止本次提交 —— 密钥连本地提交都进不去。
#
# 启用（每个新克隆做一次）：git config core.hooksPath tools/githooks
# 临时跳过某次提交：git commit --no-verify

. tools/githooks/_find-node.sh

if [ -z "$NODE" ]; then
  echo "check-secrets: 找不到 node，跳过本次扫描" >&2
  exit 0
fi

if [ -f tools/check-secrets.cjs ]; then
  exec "$NODE" tools/check-secrets.cjs --staged
fi

echo "check-secrets: 没有 tools/check-secrets.cjs，跳过" >&2
